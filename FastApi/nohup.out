                     pilot_name,
                     pilot_mobile,
                     paramedic_name,
                     paramedic_mobile,
                     assigned_time,
                     parameter_count,
                     inc_dispatch_time,
                     inc_recive_time,
                     inc_datetime,
                     acknowledge,
                     start_from_base_loc,
                     acknowledge_duration,
                     start_from_base_duration,
                     at_scene,
