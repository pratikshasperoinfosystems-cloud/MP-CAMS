                    inc_ref_id,
                     ambulance_no,
                     dst_code,
                     district_name,
                     base_location_name,
                     call_type,
                     caller_mobile,
                     pilot_name,
                     pilot_mobile,
                     paramedic_name,
                     paramedic_mobile,
                     assigned_time,
                     parameter_count,
                     inc_dispatch_time,
                     inc_recive_time,
                     inc_datetime,
                     acknowledge,
                     start_from_base_loc,
                     acknowledge_duration,
                     start_from_base_duration,
                     at_scene,
                     at_scene_duration,
                     wait_time_at_scene_duration,
                     from_scene,
                     start_from_scene_duration,
                     enroute_to_hospital_duration,
                     at_hospital,
